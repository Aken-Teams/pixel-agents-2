{
  "name": "ai-agents-office",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Agents Office — 像素風格虛擬辦公室，將 Claude Code AI 代理視覺化為動畫角色",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npx tsx watch src/index.ts",
    "dev:client": "cd client && npx vite",
    "build": "npm run build:client && npm run build:server",
    "build:server": "cd server && node esbuild.config.js",
    "build:client": "cd client && npx vite build",
    "start": "node dist/server.js",
    "slice-tileset": "cd server && npx tsx src/tilesetSlicer.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "remark-gfm": "^4.0.1"
  }
}
